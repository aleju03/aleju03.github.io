# WebSocket endpoint of the AlejOS chat server (server/ in this repo, runs on the VPS).
# Also where analytics capture goes: src/analytics.ts rewrites this to
# https://chat.example.com/peeko/capture, so there is no second URL to set.
# Leave unset and the Messenger app falls back to plain email, and the site
# stops counting its own traffic.
VITE_CHAT_URL=wss://chat.example.com/ws
